# Public Supabase project URL and publishable key used by the cookie-authenticated client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Exactly two Google account emails, comma-separated. Keep real addresses in the deployment environment.
AUTHORIZED_EMAILS=first@example.com,second@example.com

# UUID for the shared household created by the Supabase migration/provisioning process.
MESA_HOUSEHOLD_ID=00000000-0000-4000-8000-000000000000
