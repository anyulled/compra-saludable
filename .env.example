# Public Supabase project URL and publishable key used by the cookie-authenticated client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Exactly two Google account emails, comma-separated. Keep real addresses in the deployment environment.
AUTHORIZED_EMAILS=first@example.com,second@example.com

# Server-only credentials for weekly Mercadona catalog synchronization.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
ENDPOINT_OAUTH=your-external-sync-bearer-secret
